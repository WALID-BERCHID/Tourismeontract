# =============================================================================
# Tourisme – environment configuration
# Copy to .env (root, used by docker compose) or server/.env (used by npm run dev)
# =============================================================================

# ---- App -------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Public URL of the website (used in emails and sign-in messages)
APP_URL=https://tourisme.example.com
# Comma-separated origins allowed to call the API (only needed if web and API are on different domains)
CORS_ORIGINS=https://tourisme.example.com
# REQUIRED in production: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=
PLATFORM_NAME=Tourisme
# Create the demo listings/users on first start (set to 0 in production)
SEED_DEMO=0

# ---- Storage ---------------------------------------------------------------
DATABASE_FILE=/data/tourisme.db
UPLOAD_DIR=/data/uploads
# Optional CDN base for uploaded photos (defaults to /uploads on the same domain)
# PUBLIC_UPLOADS_URL=https://cdn.tourisme.example.com/uploads

# ---- Email (any SMTP provider: Resend, SendGrid, Mailgun, Postmark, SES, Gmail…) ----
# Without SMTP_HOST, emails are not sent but stored and viewable at /api/dev/emails (dev only).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Tourisme <bookings@tourisme.example.com>"

# ---- EVM chains ------------------------------------------------------------
# Only offer these chain ids for payment (default: all deployed, minus 31337 in production)
EVM_CHAIN_IDS=11155111,80002,84532
# RPC URLs are also sent to browsers to read prices – use public or domain-restricted keys.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# MAINNET_RPC_URL=  POLYGON_RPC_URL=  BASE_RPC_URL=
# Where deployments.json lives (written by `npm run deploy:<network>`)
# DEPLOYMENTS_FILE=/app/web/src/config/deployments.json
INDEXER=1
INDEXER_INTERVAL_MS=15000

# ---- Solana (optional) -------------------------------------------------------
SOLANA_ENABLED=0
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=2Nd2n5ZHj51hS7QbrfWnsbMx329m3WYKMtLxkQ4bE3rb

# ---- EOS / Antelope (optional) ----------------------------------------------
EOS_ENABLED=0
EOS_RPC_URL=https://jungle4.cryptolions.io
EOS_CONTRACT=tourismeescr
EOS_CHAIN_ID=73e4385a2708e6d7048834fbc1079f2fabb17b3c125b146af438971e90716c4d

# ---- Contract deployment (contracts/evm/.env) --------------------------------
# DEPLOYER_PRIVATE_KEY=0x…        (never commit!)
# ARBITER_ADDRESS=0x…             dispute resolver (multisig recommended)
# TREASURY_ADDRESS=0x…            receives platform fees
# USDC_ADDRESS=0x…                real USDC on the target chain (skip to deploy a test USDC)
# ETHERSCAN_API_KEY=
